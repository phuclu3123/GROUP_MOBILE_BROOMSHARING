# Server only. Never copy these keys into Android BuildConfig or resources.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
FIREBASE_PROJECT_ID=broom-sharing-firebase-mobile
FIRESTORE_DATABASE_ID=broomsharing
# Absolute path to a server service-account JSON, or use ADC on hosting.
GOOGLE_APPLICATION_CREDENTIALS=
# HTTPS public address of this Java server, without trailing slash.
PUBLIC_BASE_URL=
# One demo merchant: only bookings owned by this UID can create payment links.
PAYMENT_DEMO_HOST_UID=
PORT=8090
# Local demo is reached through the HTTPS tunnel; hosting may set 0.0.0.0 explicitly.
BIND_HOST=127.0.0.1
# Optional: reuse the deployed WEB_TCC webhook as a signed-event relay.
PAYOS_RELAY_BASE_URL=https://ueh-tcc-backend.onrender.com
# Existing PAYOS_CONFIRM_TOKEN from WEB_TCC; server only, never Android.
PAYOS_RELAY_TOKEN=
