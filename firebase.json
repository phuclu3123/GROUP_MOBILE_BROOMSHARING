{
  "firestore": [
    {
      "database": "broomsharing",
      "rules": "firestore.secure.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
