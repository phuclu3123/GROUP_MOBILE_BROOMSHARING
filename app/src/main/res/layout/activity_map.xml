<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Văn phòng gần bạn · TP.HCM" android:textSize="20sp" android:textStyle="bold" android:padding="12dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:gravity="center_vertical">
        <EditText android:id="@+id/mapAddress" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Địa chỉ xuất phát tại TP.HCM" android:inputType="textPostalAddress" android:maxLength="200" android:maxLines="1" android:imeOptions="actionSearch" android:textSize="14sp" />
        <Button android:id="@+id/mapSearch" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Tìm" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="8dp">
        <Button android:id="@+id/mapGps" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Vị trí của tôi" />
        <Button android:id="@+id/mapRetry" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Thử lại bản đồ" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/mapOrigin" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:textSize="12sp" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="160dp">
        <ViewStub android:id="@+id/mapStub" android:layout_width="match_parent" android:layout_height="match_parent" android:layout="@layout/view_map_canvas" />
        <ProgressBar android:id="@+id/mapProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" />
        <ImageView android:id="@+id/mapTilerLogo" android:layout_width="100dp" android:layout_height="30dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="#DDFFFFFF" android:src="@drawable/maptiler_logo" android:contentDescription="MapTiler" />
        <TextView android:id="@+id/mapCredits" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:background="#EEFFFFFF" android:padding="3dp" android:textSize="10sp" android:textColor="#333333" />
    </FrameLayout>
    <TextView android:id="@+id/mapMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:textSize="12sp" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/mapDestination" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="8dp">
        <Button android:id="@+id/mapRoute" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Chỉ đường ô tô" android:enabled="false" />
        <Button android:id="@+id/mapDetail" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Xem phòng" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/mapRoomMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:textSize="12sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/mapRooms" android:layout_width="match_parent" android:layout_height="120dp" android:visibility="gone" />
    <Button android:id="@+id/mapMore" android:layout_width="match_parent" android:layout_height="48dp" android:text="Tải văn phòng" />
    <include layout="@layout/view_guest_navigation" />
</LinearLayout>
