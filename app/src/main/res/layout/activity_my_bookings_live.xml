<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/screen_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@color/white">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingTop="16dp" android:paddingBottom="16dp" android:text="@string/booking_mine" style="@style/WorkspaceSection" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/workspace_refresh" style="@style/Widget.MaterialComponents.Button.TextButton" />
    </LinearLayout>
    <TextView android:padding="16dp" android:text="@string/guest_bookings_hint" style="@style/WorkspaceBody" />
    <Spinner android:id="@+id/bookingFilter" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_input" android:entries="@array/booking_filter_options" android:contentDescription="@string/booking_mine" />
    <TextView android:id="@+id/feedback" android:padding="16dp" android:accessibilityLiveRegion="polite" style="@style/WorkspaceBody" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/bookings" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp" android:clipToPadding="false" />
    <include layout="@layout/view_guest_navigation" />
</LinearLayout>