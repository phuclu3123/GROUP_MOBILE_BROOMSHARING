<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/workspaceRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/screen_bg">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/reportToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="Báo cáo thông tin phòng" app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/guest_detail_back" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mô tả vấn đề cụ thể để Admin kiểm tra. Báo cáo không tự hủy đặt chỗ hoặc hoàn tiền. Tệp ảnh/bằng chứng sẽ được bổ sung sau." android:paddingBottom="16dp" />
        <Spinner android:id="@+id/reportReason" android:layout_width="match_parent" android:layout_height="56dp" android:contentDescription="Loại vấn đề" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/reportDescriptionLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mô tả vấn đề (20–2.000 ký tự)"><com.google.android.material.textfield.TextInputEditText android:id="@+id/reportDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences" android:minLines="5" android:maxLength="2000" android:gravity="top" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/reportSubmit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gửi báo cáo" android:textAllCaps="false" />
        <ProgressBar android:id="@+id/reportProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/reportStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:accessibilityLiveRegion="polite" />
    </LinearLayout></androidx.core.widget.NestedScrollView>
</LinearLayout>
