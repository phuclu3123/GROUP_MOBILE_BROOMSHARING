<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/screen_bg">
    <Button android:id="@+id/back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quay lại" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Phòng đã lưu" android:textSize="22sp" android:textStyle="bold" />
    <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tải lại" />
    <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:accessibilityLiveRegion="polite" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
