<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/workspaceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/workspace_back_overview"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/WorkspaceBody"
                android:text="Xác thực Bất Động Sản"
                android:textColor="@color/teal_dark"
                android:textStyle="bold" />

            <TextView
                style="@style/WorkspaceSection"
                android:text="Hồ sơ xác minh" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workspace_refresh"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Tabs: Nộp mới vs Danh sách đã gửi -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/verificationTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabIndicatorColor="@color/teal_dark"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/teal_dark"
        app:tabTextColor="@color/text_secondary" />

    <ScrollView
        android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/WorkspaceTitle"
                android:text="Gửi hồ sơ xác minh mới"
                android:textSize="16sp" />

            <TextView
                style="@style/WorkspaceBody"
                android:layout_marginTop="4dp"
                android:text="Admin đối chiếu thông tin và bằng chứng trước khi xét duyệt. Kết quả là kiểm tra nội bộ của ứng dụng." />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Chọn không gian cần xác minh (*)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSpaces"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Loại xác minh (*)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgVerificationType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Địa điểm" />

                <RadioButton
                    android:id="@+id/rbPhotos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ảnh không gian" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mô tả bằng chứng / giấy tờ (*)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="Ghi chú về giấy phép kinh doanh, số hợp đồng hoặc tình trạng không gian..."
                android:inputType="textMultiLine"
                android:lines="3"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tệp hình ảnh / Tài liệu đính kèm"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickEvidence"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_outline"
                    android:text="Chọn ảnh minh chứng"
                    android:textAllCaps="false"
                    android:textColor="@color/teal_dark" />

                <TextView
                    android:id="@+id/tvEvidenceFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Chưa chọn tệp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivEvidencePreview"
                android:layout_width="120dp"
                android:layout_height="90dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_image_placeholder"
                android:contentDescription="Xem trước ảnh"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSubmitVerification"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:text="Gửi hồ sơ xác minh cho Admin"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView style="@style/WorkspaceBody" android:layout_marginTop="8dp"
                android:text="Tệp demo được lưu công khai theo URL trên Cloudinary. Không đính kèm giấy tờ thật hoặc thông tin khách hàng nhạy cảm." />
        </LinearLayout>
    </ScrollView>

    <!-- List of submitted verifications -->
    <LinearLayout
        android:id="@+id/layoutList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVerifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvEmptyVerifications"
            style="@style/WorkspaceBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Chưa có hồ sơ xác minh nào được gửi."
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</LinearLayout>
