<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/screen_bg">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_manual_verification" android:padding="8dp" />
    <TextView android:id="@+id/feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:accessibilityLiveRegion="polite" />
    <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="@string/admin_evidence" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/previous" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/admin_previous_page" />
        <Button android:id="@+id/next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/admin_next_page" />
    </LinearLayout>
    <Button android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_refresh" />
    <Button android:id="@+id/close" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_evidence_back" />
</LinearLayout>
