<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/workspaceRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/screen_bg">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/noticeToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="Cập nhật của bạn" app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/guest_detail_back" />
    <include android:id="@+id/pendingCheckout" layout="@layout/view_pending_checkout" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Cập nhật khi bạn mở hoặc đang dùng ứng dụng. Lời nhắc không thay đổi quyền hủy; hệ thống kiểm tra lại khi bạn xác nhận hủy." android:textColor="@color/text_secondary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/noticePermission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:text="Bật thông báo trên thiết bị" android:textAllCaps="false" />
    <TextView android:id="@+id/noticeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButton android:id="@+id/noticeRetry" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:text="Thử đồng bộ lại" android:textAllCaps="false" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/noticeList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="16dp" />
</LinearLayout>
