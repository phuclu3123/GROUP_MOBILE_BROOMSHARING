    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" />
    <Button android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xem phòng" />
