<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp" android:background="@color/white"
    android:visibility="gone">
    <TextView android:id="@+id/pendingSummary" style="@style/WorkspaceBody"
        android:textColor="@color/teal_dark" android:accessibilityLiveRegion="none" />
    <com.google.android.material.button.MaterialButton android:id="@+id/pendingResume"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="Tiếp tục thanh toán" android:textAllCaps="false" />
</LinearLayout>
