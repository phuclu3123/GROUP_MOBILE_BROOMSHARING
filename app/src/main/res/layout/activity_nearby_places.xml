<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/workspaceRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/screen_bg">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/placesToolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="Tiện ích xung quanh" app:navigationIcon="@drawable/ic_arrow_back" app:navigationContentDescription="@string/guest_detail_back" />
    <TextView android:id="@+id/placesCenter" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textColor="@color/navy" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp" android:text="Trong 1 km · Lọc ăn uống, giao thông, bãi đỗ và cửa hàng tiện lợi từ 10 POI gần nhất MapTiler trả về. Không phải danh sách đầy đủ. Khoảng cách đường thẳng; chưa xác nhận giờ mở cửa." android:textColor="@color/text_secondary" />
    <ProgressBar android:id="@+id/placesProgress" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/placesStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButton android:id="@+id/placesRetry" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:text="Thử lại" android:textAllCaps="false" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/placesList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="16dp" />
    <TextView android:id="@+id/placesCredits" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="© MapTiler · © OpenStreetMap contributors · ODbL" android:textSize="12sp" android:textColor="@color/teal_dark" />
</LinearLayout>
