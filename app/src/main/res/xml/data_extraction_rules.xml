<?xml version="1.0" encoding="utf-8"?>
<!-- Tài khoản tải lại bản lưu từ server sau khi chuyển sang thiết bị khác. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="broom_offline.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="broom_offline.db" />
    </device-transfer>
</data-extraction-rules>
