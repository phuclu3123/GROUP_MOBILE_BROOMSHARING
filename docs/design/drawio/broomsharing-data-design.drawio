ry" /></mxCell><mxCell id="03-chat-91" value="messages is inside one conversation document, never directly inside the conversations collection. Full logical references: R25-R34 in the companion dictionary.&#10;One ordered renter-Host pair has one conversation. Admin does not automatically have permission to read private messages." style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=15;fontColor=#61778B;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="60" y="1085" width="2700" height="90" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="04-administration-reference" name="BROOMSHARING  /  ADMIN &amp; REFERENCE STORAGE"><mxGraphModel dx="3320" dy="2140" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3320" pageHeight="2140" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="04-administration-reference-1" value="BROOMSHARING  /  ADMIN &amp; REFERENCE STORAGE" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=28;fontColor=#16324F;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="3200" height="50" as="geometry" /></mxCell><mxCell id="04-administration-reference-2" value="Sibling root collections and their documents | Private verification, moderation, audit and map reference" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=17;fontColor=#61778B;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="3200" height="42" as="geometry" /></mxCell><mxCell id="db-admin" value="" style="rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="1