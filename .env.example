# Copy to .env, which Git ignores. These client keys are embedded in the APK.
MapTiler_API_KEY=
HeiGIT_API_KEY=

# Cloudinary unsigned preset. Both values are public client configuration, not secrets.
# Create the preset once using docs/integrations/cloudinary-setup.md, then rebuild the APK.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# Do not add CLOUDINARY_API_SECRET: this Android integration does not use it.

# Public HTTPS origin of the separate Java backend. Leave empty to disable checkout.
PAYMENT_API_BASE_URL=
# PAYOS_CLIENT_ID/API_KEY/CHECKSUM_KEY belong ONLY in backend/payments/.env.
